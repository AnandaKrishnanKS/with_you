# Database Connection (SQLite default for simple local dev, or Postgres URL)
DATABASE_URL="file:./dev.db"

# Environment Mode for Providers (mock | live)
# In development mode, setting PROVIDER_MODE=mock enables all zero-config mock implementations
PROVIDER_MODE="mock"

# Auth Secrets
JWT_SECRET="with_you_super_secret_jwt_key_2026_dev"
NEXTAUTH_SECRET="with_you_nextauth_secret_dev"
NEXTAUTH_URL="http://localhost:3000"

# Razorpay Payment Gateway (Live mode keys)
RAZORPAY_KEY_ID="rzp_test_mock_key"
RAZORPAY_KEY_SECRET="mock_secret"
RAZORPAY_WEBHOOK_SECRET="mock_wh_secret"

# KYC Provider (DigiLocker / Digio / IDfy)
DIGILOCKER_CLIENT_ID="mock_digilocker"
DIGILOCKER_CLIENT_SECRET="mock_digilocker_secret"

# Video Call Provider (100ms / Agora / Daily.co)
AGORA_APP_ID="mock_agora_app_id"
AGORA_APP_CERTIFICATE="mock_agora_cert"

# Email Provider (Resend / SES)
RESEND_API_KEY="re_mock_12345"

# SMS Provider (MSG91)
MSG91_AUTH_KEY="mock_msg91_key"
MSG91_TEMPLATE_ID="mock_template"

# Storage Provider (S3 / Cloudinary)
STORAGE_BUCKET_NAME="with-you-private-docs"
STORAGE_REGION="ap-south-1"
